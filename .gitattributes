# Project Genesis v2.0 — repository-wide line-ending policy
# Text is stored as LF in Git; explicitly listed source/config files
# are also checked out as LF on Windows, macOS, and Linux.
* text=auto

# Source code
*.py          text eol=lf
*.java        text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.cs          text eol=lf
*.go          text eol=lf
*.c           text eol=lf
*.cc          text eol=lf
*.cpp         text eol=lf
*.h           text eol=lf
*.hpp         text eol=lf
*.sh          text eol=lf

# Documentation and configuration
*.md          text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.jsonl       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.toml        text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.sql         text eol=lf
*.properties  text eol=lf
.gitattributes text eol=lf
.gitignore    text eol=lf

# Windows command scripts
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binary assets: never perform line-ending conversion
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.pdf         binary
*.zip         binary
*.jar         binary
*.doc         binary
*.docx        binary
*.xls         binary
*.xlsx        binary
*.ppt         binary
*.pptx        binary

# Immutable research inputs and exact-byte test fixtures.
# Keep these paths byte-for-byte as committed, even when text-like.
# More specific rules must appear after the general extension rules.
experiments/original-ai-code/** -text -eol
tests/fixtures/**             -text -eol
experiments/java-pilot/manifests/** -text -eol
